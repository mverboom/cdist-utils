# shellcheck shell=bash
# Bash completion for eq. Source this file, or install it as an
# /etc/bash_completion.d or ~/.local/share/bash-completion/completions/eq file.

_eq_explorer_names() {
   test -n "$CDIST_EXPLORE" && test -d "$CDIST_EXPLORE" || return 0
   find "$CDIST_EXPLORE" -mindepth 2 -maxdepth 2 -type f -printf '%f\n' \
      2> /dev/null | sort -u
}

_eq_host_names() {
   if test -n "$CDIST_EXPLORE" && test -d "$CDIST_EXPLORE"; then
      find "$CDIST_EXPLORE" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' \
         2> /dev/null | sort
   else
      cdist inventory list -H 2> /dev/null
   fi
}

_eq_tag_names() {
   cdist inventory list 2> /dev/null | sed -n 's/.* //; s/,/\n/gp' | sort -u
}

# Complete a possibly comma separated list, keeping the part before the last
# comma as a prefix.
_eq_complete_list() {
   local wordlist="$1" cur="$2" matches match
   local prefix="" rest="$cur"
   if [[ "$cur" == *,* ]]; then
      prefix="${cur%,*},"
      rest="${cur##*,}"
   fi
   matches="$(compgen -W "$wordlist" -- "$rest" || true)"
   COMPREPLY=()
   for match in $matches; do
      COMPREPLY+=("${prefix}${match}")
   done
}

# Complete the modifier after the last colon of a field spec, for example
# "packages:~<TAB>".
_eq_complete_modifiers() {
   local cur="$1"
   local prefix="${cur%:*}:" rest="${cur##*:}" matches match
   # Tilde is not passed to compgen: it would be expanded to $HOME.
   local mods="f1 f2 f3 l1 l2 trim lower upper sort unique"
   matches="$(compgen -W "$mods" -- "$rest" || true)"
   COMPREPLY=()
   if [[ "$rest" == "" || "$rest" == "~" ]]; then
      COMPREPLY+=("${prefix}~")
   fi
   for match in $matches; do
      COMPREPLY+=("${prefix}${match}")
   done
}

_eq_completions() {
   local cur prev base fields
   local opts flags value_opts binary_ops unary_ops logic
   local -a expr
   local i word last second_last

   cur="${COMP_WORDS[COMP_CWORD]}"
   prev="${COMP_WORDS[COMP_CWORD-1]}"
   COMPREPLY=()

   opts="-h -H -t -T -r -q -j -w -x -V --help --hosts --tags --all-tags
         --report --query --json --html --tsv --csv --header --sort --count
         --limit --list-explorers --list-tags --values --debug --version"
   flags="-h --help -j --json -w --html --tsv --csv --header --count
          --list-explorers --list-tags -x --debug -V --version"
   value_opts="-r --report -H --hosts -t --tags -T --all-tags -q --query
               --values --sort --limit"
   binary_ops="= == ne eq gt ge lt le contains icontains matches startswith
               endswith in"
   unary_ops="exists empty nonempty"
   logic="and or not"
   mapfile -t fields < <(_eq_explorer_names)

   if [[ "$cur" == -* ]]; then
      mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
      return
   fi

   if [[ "$cur" == *:* ]]; then
      base="${cur%%:*}"
      if [[ " ${fields[*]} " == *" $base "* ]]; then
         _eq_complete_modifiers "$cur"
         return
      fi
   fi

   # Completing the value of an option.
   case "$prev" in
   -r | --report)
      _eq_complete_list "${fields[*]}" "$cur"
      return
      ;;
   -H | --hosts)
      _eq_complete_list "$(_eq_host_names)" "$cur"
      return
      ;;
   -t | --tags | -T | --all-tags)
      _eq_complete_list "$(_eq_tag_names)" "$cur"
      return
      ;;
   --values | --sort)
      mapfile -t COMPREPLY < <(compgen -W "${fields[*]} host" -- "$cur")
      return
      ;;
   -q | --query | --limit)
      return
      ;;
   esac

   # Rebuild the expression tokens by dropping options and their arguments.
   # This keeps the position detection correct for things like
   # "eq -r fqdn <TAB>", where a fresh word starts after the option value.
   for ((i = 1; i < COMP_CWORD; i++)); do
      word="${COMP_WORDS[i]}"
      if [[ "$word" == --*=* ]]; then
         continue
      fi
      if [[ " $value_opts " == *" $word "* ]]; then
         i=$((i + 1))
         continue
      fi
      if [[ " $flags " == *" $word "* ]]; then
         continue
      fi
      expr+=("$word")
   done

   # No expression yet: start of a query.
   if [ "${#expr[@]}" -eq 0 ]; then
      mapfile -t COMPREPLY < <(compgen -W "[ ( ${fields[*]} $opts" -- "$cur")
      return
   fi

   last="${expr[-1]}"
   second_last=""
   if [ "${#expr[@]}" -ge 2 ]; then
      second_last="${expr[-2]}"
   fi

   # After an operand (the token before the last was a binary operator).
   if [ "${#expr[@]}" -ge 2 ] && [[ " $binary_ops " == *" $second_last "* ]]; then
      mapfile -t COMPREPLY < <(compgen -W "] ) and or" -- "$cur")
      return
   fi
   if [[ " $binary_ops " == *" $last "* ]]; then
      return
   fi
   if [[ " $unary_ops " == *" $last "* ]]; then
      mapfile -t COMPREPLY < <(compgen -W "] ) and or" -- "$cur")
      return
   fi
   if [[ " $logic " == *" $last "* ]]; then
      mapfile -t COMPREPLY < <(compgen -W "[ ( ${fields[*]}" -- "$cur")
      return
   fi
   if [[ "$last" == "]" || "$last" == ")" ]]; then
      mapfile -t COMPREPLY < <(compgen -W "$logic" -- "$cur")
      return
   fi
   if [[ "$last" == "[" || "$last" == "(" ]]; then
      mapfile -t COMPREPLY < <(compgen -W "${fields[*]}" -- "$cur")
      return
   fi

   # The last token is a field: complete the operators.
   mapfile -t COMPREPLY < <(compgen -W "$binary_ops $unary_ops" -- "$cur")
}

complete -F _eq_completions eq
