# shellcheck shell=bash
# Bash completion for eq. Source this file, or install it as an
# /etc/bash_completion.d or ~/.local/share/bash-completion/completions/eq file.
#
# Candidates and their help text come from `eq --complete`, so the tool is the
# single source of truth. Pressing Tab twice prints a description legend for
# the current candidates. Set EQ_FZF=1 to pick from a described fuzzy menu
# when fzf is installed.

_eq_complete_call() {
   command eq --complete "$@" 2> /dev/null
}

_eq_host_names() {
   _eq_complete_call hosts
}

_eq_tag_names() {
   _eq_complete_call tags
}

# Complete a comma separated list of plain values.
_eq_complete_list() {
   local wordlist="$1" cur="$2" matches match
   local prefix="" rest="$cur"
   if [[ "$cur" == *,* ]]; then
      prefix="${cur%,*},"
      rest="${cur##*,}"
   fi
   matches="$(compgen -W "$wordlist" -- "$rest" || true)"
   COMPREPLY=()
   for match in $matches; do
      COMPREPLY+=("${prefix}${match}")
   done
}

# Use fzf for completion when it is installed. Set EQ_PLAIN=1 (or EQ_FZF=0)
# to keep the plain completion.
_eq_use_fzf() {
   [ -n "${EQ_PLAIN:-}" ] && return 1
   [ "${EQ_FZF:-1}" = "0" ] && return 1
   command -v fzf > /dev/null 2>&1
}

# Set COMPREPLY from "value<TAB>description" lines, filtered by the rest of the
# word. prefix is prepended to each value. With fzf installed a described fuzzy
# menu is shown (a single match is selected without a menu). Without fzf the
# descriptions are printed on the second Tab.
_eq_reply_annotated() {
   local annotated="$1" prefix="${2:-}" rest="${3:-}"
   local filtered picked
   filtered="$(printf '%s\n' "$annotated" | awk -F'\t' -v p="$rest" '
      p == "" || index($1, p) == 1 {
         if (NF > 1 && $2 != "") print $1 "\t" $2
         else print $1
      }')"
   COMPREPLY=()
   [ -z "$filtered" ] && return

   if _eq_use_fzf; then
      # fzf uses an inline window; ask readline to redraw the line afterwards,
      # otherwise the command line is left visually corrupted.
      bind '"\e[0n": redraw-current-line' 2> /dev/null || true
      picked="$(printf '%s\n' "$filtered" | \
         fzf --height=40% --reverse --delimiter="$(printf '\t')" \
         --with-nth=1,2 --nth=1 --select-1 --exit-0)" || true
      [ -t 1 ] && printf '\e[5n'
      if [ -n "$picked" ]; then
         mapfile -t COMPREPLY < <(printf '%s\n' "$picked" | cut -f1 | \
            awk -v pre="$prefix" '{print pre $0}')
      fi
      return
   fi

   if [ "$COMP_TYPE" = "?" ]; then
      printf '%s\n' "$filtered" | awk -F'\t' -v pre="$prefix" -v n=18 '
         NF > 1 && $2 != "" {printf "  %-*s %s\n", n, pre $1, $2}' >&2
   fi
   mapfile -t COMPREPLY < <(printf '%s\n' "$filtered" | cut -f1 | \
      awk -v pre="$prefix" '{print pre $0}')
}

# Complete the modifiers after the last colon of a field spec.
_eq_complete_modifiers() {
   local cur="$1"
   _eq_reply_annotated "$(_eq_complete_call modifiers)" "${cur%:*}:" \
      "${cur##*:}"
}

# Complete a field spec, including modifiers, honouring a comma list prefix.
_eq_complete_fields() {
   local cur="$1" annotated="$2" fieldlist="$3" fieldspec prefix base
   if [[ "$cur" == *,* ]]; then
      prefix="${cur%,*},"
      fieldspec="${cur##*,}"
   else
      prefix=""
      fieldspec="$cur"
   fi
   if [[ "$fieldspec" == *:* ]]; then
      base="${fieldspec%%:*}"
      if [[ " $fieldlist " == *" $base "* ]]; then
         _eq_complete_modifiers "$cur"
         return
      fi
   fi
   _eq_reply_annotated "$annotated" "$prefix" "$fieldspec"
}

# Split the current line up to the cursor into words, honouring simple quotes.
# bash breaks COMP_WORDS on COMP_WORDBREAKS characters such as ':' and '=',
# which would otherwise split "packages:~^nginx" or "==" apart.
_eq_split_line() {
   local line="${COMP_LINE:0:COMP_POINT}"
   local word="" quote="" char i
   _EQ_LINE_WORDS=()
   for ((i = 0; i < ${#line}; i++)); do
      char="${line:i:1}"
      if [ -n "$quote" ]; then
         if [ "$char" = "$quote" ]; then
            quote=""
         else
            word+="$char"
         fi
      elif [ "$char" = "'" ] || [ "$char" = '"' ]; then
         quote="$char"
      elif [ "$char" = " " ] || [ "$char" = $'\t' ]; then
         _EQ_LINE_WORDS+=("$word")
         word=""
      else
         word+="$char"
      fi
   done
   _EQ_LINE_WORDS+=("$word")
}

_eq_completions() {
   local cur prev base opts flags value_opts fields_annotated
   local binary_ops unary_ops logic
   local -a fields expr words
   local i word last second_last cidx

   COMPREPLY=()

   # Build the word list from the raw line when possible. bash splits
   # COMP_WORDS on COMP_WORDBREAKS characters such as ':' and '=', which would
   # split a field spec like "packages:~^nginx" in the wrong place.
   if [ -n "${COMP_LINE:-}" ] && [ "${COMP_POINT:-0}" -gt 0 ]; then
      _eq_split_line
      words=("${_EQ_LINE_WORDS[@]}")
   else
      words=("${COMP_WORDS[@]}")
   fi
   cidx=$((${#words[@]} - 1))
   cur="${words[cidx]}"
   prev=""
   [ "$cidx" -gt 0 ] && prev="${words[cidx-1]}"

   opts="-h -H -t -T -r -q -j -w -x -V --help --hosts --tags --all-tags
         --report --query --json --html --tsv --csv --header --sort --count
         --limit --list-explorers --list-tags --values --complete --operators
         --modifiers --build --debug --version"
   flags="-h --help -j --json -w --html --tsv --csv --header --count
          --list-explorers --list-tags -x --debug -V --version --operators
          --modifiers --build"
   value_opts="-r --report -H --hosts -t --tags -T --all-tags -q --query
               --values --sort --limit --complete"
   # Kept here for cheap state detection; the candidates and their help text
   # come from eq --complete operators.
   binary_ops="= == ne eq gt ge lt le contains icontains matches startswith
               endswith in"
   unary_ops="exists empty nonempty"
   logic="and or not"

   fields_annotated="$(_eq_complete_call fields)"
   mapfile -t fields < <(printf '%s\n' "$fields_annotated" | cut -f1)

   if [[ "$cur" == -* ]]; then
      mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
      return
   fi

   if [[ "$cur" == *:* ]]; then
      base="${cur##*,}"
      base="${base%%:*}"
      if [[ " ${fields[*]} " == *" $base "* ]]; then
         _eq_complete_fields "$cur" "$fields_annotated" "${fields[*]}"
         return
      fi
   fi

   # Completing the value of an option.
   case "$prev" in
   -r | --report)
      _eq_complete_fields "$cur" "$fields_annotated" "${fields[*]}"
      return
      ;;
   -H | --hosts)
      _eq_complete_list "$(_eq_host_names)" "$cur"
      return
      ;;
   -t | --tags | -T | --all-tags)
      _eq_complete_list "$(_eq_tag_names)" "$cur"
      return
      ;;
   --values | --sort)
      if [[ "$cur" == *:* ]]; then
         _eq_complete_fields "$cur" "$fields_annotated" "${fields[*]}"
      else
         _eq_reply_annotated "$fields_annotated
host" "" "$cur"
      fi
      return
      ;;
   -q | --query | --limit)
      return
      ;;
   esac

   # Rebuild the expression tokens by dropping options and their arguments, so
   # the position stays correct after something like "eq -r fqdn <TAB>".
   for ((i = 1; i < cidx; i++)); do
      word="${words[i]}"
      [[ "$word" == --*=* ]] && continue
      if [[ " $value_opts " == *" $word "* ]]; then
         i=$((i + 1))
         continue
      fi
      [[ " $flags " == *" $word "* ]] && continue
      expr+=("$word")
   done

   # Start of a query.
   if [ "${#expr[@]}" -eq 0 ]; then
      _eq_reply_annotated "$(printf '%s\n' '[' '(' $opts)
$fields_annotated" "" "$cur"
      return
   fi

   last="${expr[-1]}"
   second_last=""
   [ "${#expr[@]}" -ge 2 ] && second_last="${expr[-2]}"

   # After an operand.
   if [ "${#expr[@]}" -ge 2 ] && [[ " $binary_ops " == *" $second_last "* ]]; then
      _eq_reply_annotated "$(_eq_complete_call logical)
]
)" "" "$cur"
      return
   fi
   # Operand position: offer the real values of the field.
   if [[ " $binary_ops " == *" $last "* ]]; then
      _eq_reply_annotated "$(_eq_complete_call values "$second_last")" "" "$cur"
      return
   fi
   # After a unary operator.
   if [[ " $unary_ops " == *" $last "* ]]; then
      _eq_reply_annotated "$(_eq_complete_call logical)
]
)" "" "$cur"
      return
   fi
   if [[ " $logic " == *" $last "* ]]; then
      _eq_reply_annotated "$fields_annotated
[
(" "" "$cur"
      return
   fi
   if [[ "$last" == "]" || "$last" == ")" ]]; then
      _eq_reply_annotated "$(_eq_complete_call logical)" "" "$cur"
      return
   fi
   if [[ "$last" == "[" || "$last" == "(" ]]; then
      _eq_reply_annotated "$fields_annotated" "" "$cur"
      return
   fi

   # The last token is a field: complete the operators with their help.
   _eq_reply_annotated "$(_eq_complete_call operators)" "" "$cur"
}

complete -F _eq_completions eq
