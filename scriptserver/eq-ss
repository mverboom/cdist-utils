#!/usr/bin/env python3
"""script-server wrapper for eq.

The "Explorer Query" runner has two actions:

* ``--action builder`` prints the interactive query builder page. The page is
  rendered with ``output_format: html_iframe``, so it runs as real HTML/JS in a
  same-origin iframe.
* ``--action run`` runs ``eq -w`` with the received flags and prints the result
  as an HTML page with a link back to the builder.

The builder does not call any script-server API: its Run button navigates the
top window to this runner's hash route with the parameters prefilled (the same
deep-link mechanism used by the needrestart report).
"""

from __future__ import annotations

import argparse
import html
import json
import subprocess
import sys
import urllib.parse
from pathlib import Path

HERE = Path(__file__).resolve().parent
TEMPLATE = HERE / "eq-builder.html"
RUNNER = "Explorer Query"

RESULT_PAGE = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Explorer Query result</title>
<style>
body {{ font-family: system-ui, sans-serif; margin: 1rem; }}
table {{ border-collapse: collapse; }}
td, th {{ border: 1px solid #999; padding: 0.25rem 0.5rem; text-align: left; }}
pre.error {{ color: #b00; white-space: pre-wrap; }}
code {{ background: #f4f4f4; padding: 0.1rem 0.3rem; }}
</style>
</head>
<body>
<p><a href="{back}" target="_top">&#8592; back to the query builder</a></p>
<p><code>{command}</code></p>
{body}
</body>
</html>
"""


def load_runner() -> tuple[str, str, str]:
    """Return (runner name, builder label, run label) from eq.json.

    A deep-link must use the ``values_ui_mapping`` labels, not the raw list
    values: script-server keeps the mapped user value in the form and maps it
    back to the script value for the command and the include path.
    """
    config = json.loads((HERE / "eq.json").read_text())
    labels: dict[str, str] = {}
    for parameter in config.get("parameters", []):
        if parameter.get("name") == "Action":
            labels = parameter.get("values_ui_mapping", {})
    return (
        config.get("name", RUNNER),
        labels.get("builder", "builder"),
        labels.get("run", "run"),
    )


def builder_url(runner: str, action_label: str) -> str:
    """Return a top-level hash route for this runner with the action pinned."""
    name = urllib.parse.quote(runner, safe="")
    action = urllib.parse.quote(action_label, safe="")
    return f"#/{name}?Action={action}"


def render_builder() -> int:
    """Print the interactive query builder with the catalog embedded."""
    result = subprocess.run(
        ["eq", "--catalog"], capture_output=True, text=True, timeout=120
    )
    if result.returncode != 0:
        sys.stderr.write(result.stderr or "eq --catalog failed")
        return result.returncode
    runner, action_builder, action_run = load_runner()
    data = json.loads(result.stdout)
    data["runner"] = runner
    data["actionBuilder"] = action_builder
    data["actionRun"] = action_run
    payload = json.dumps(data, ensure_ascii=False).replace("</", "<\\/")
    page = TEMPLATE.read_text().replace("__EQ_CATALOG__", payload)
    sys.stdout.write(page)
    return 0


def _report_fields(eq_args: list[str]) -> list[str]:
    """Return the -r report fields in order."""
    for i, arg in enumerate(eq_args):
        if arg == "-r" and i + 1 < len(eq_args):
            return [field for field in eq_args[i + 1].split(",") if field]
    return []


def _render_table(columns: list[str], rows: list[dict]) -> str:
    """Render a table with exactly the given columns."""
    head = "".join(f"<th>{html.escape(column)}</th>" for column in columns)
    lines = ["<table>", f"<tr>{head}</tr>"]
    for row in rows:
        cells = []
        for column in columns:
            value = str(row.get(column, ""))
            cells.append(
                "<td>" + html.escape(value).replace("\n", "<br>") + "</td>"
            )
        lines.append("<tr>" + "".join(cells) + "</tr>")
    lines.append("</table>")
    return "\n".join(lines)


def render_query(eq_args: list[str]) -> int:
    """Run eq and print an HTML page with the results and a back link.

    The output is built from ``eq -j`` using only the requested ``-r`` fields,
    so the table matches the CLI columns instead of always prepending a
    hostname column (which the ``-w`` HTML output does).
    """
    reports = _report_fields(eq_args)
    result = subprocess.run(
        ["eq", "-j", *eq_args], capture_output=True, text=True, timeout=600
    )
    rows = None
    if result.returncode == 0:
        try:
            rows = json.loads(result.stdout)
        except ValueError:
            rows = None
    runner, action_builder, _ = load_runner()
    if rows is None:
        body = '<pre class="error">' + html.escape(
            result.stderr or result.stdout or "eq failed"
        ) + "</pre>"
    else:
        body = _render_table(reports or ["hostname"], rows)
    sys.stdout.write(
        RESULT_PAGE.format(
            back=html.escape(builder_url(runner, action_builder), quote=True),
            command=html.escape("eq " + " ".join(eq_args)),
            body=body,
        )
    )
    return result.returncode


def main(argv: list[str]) -> int:
    """Entry point: dispatch on the Action parameter."""
    parser = argparse.ArgumentParser(prog="eq-ss", add_help=False)
    parser.add_argument("--action", default="builder")
    args, rest = parser.parse_known_args(argv)
    if args.action == "run":
        return render_query(rest)
    return render_builder()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
