#!/usr/bin/env python3
"""cdist-graph - visualise the dependency graph of a host's cdist object tree.

The graph is built from the object tree cdist leaves behind in
~/.cdist/cache for the most recent run of a host. It shows the
require/autorequire relationships, i.e. the execution-order dependencies
cdist resolves between objects. No host is contacted and nothing is
configured.

Three views are available:

* tree    - the run as layered levels, top-down: level 0 holds objects that
            nothing has to wait for (they can run in parallel), the next level
            the objects that require something from level 0, and so on. Long
            pass-through chains are collapsed into one node so the tree stays
            readable.
* types   - objects collapsed to their type (e.g. __file -> __package), with
            the number of objects and edges per type. Compact network overview.
* objects - every object as its own node, grouped in a cluster per type.
            Detailed network; meant to be narrowed with --focus or --types.

Default output is a self-contained HTML page (interactive pan/zoom) meant
for script-server's html_iframe output format. --dot and --svg dump the
raw representations instead.

Helper subcommands --list-hosts, --list-types and --list-objects feed
script-server parameter values.
"""

import argparse
import html
import os
import shutil
import signal
import subprocess
import sys
from collections import Counter, defaultdict, deque

# Behave like a normal Unix filter when output is piped to head etc.
if hasattr(signal, "SIGPIPE"):
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)

CACHE_DIR = os.path.join(os.path.expanduser("~"), ".cdist", "cache")

NODE_ATTR = ('shape=box, style="rounded,filled", fillcolor="#f2f2f2", '
             'fontname="Helvetica", fontsize=10, margin="0.06,0.03"')
TREE_NODE_ATTR = ('shape=box, style="rounded,filled", fillcolor="#f2f2f2", '
                  'fontname="Helvetica", fontsize=10, margin="0.05,0.02"')
EDGE_ATTR = 'fontname="Helvetica", fontsize=9, color="#333333", arrowsize=0.7'
TREE_EDGE_ATTR = 'fontname="Helvetica", fontsize=8, color="#333333", arrowsize=0.6'


def fail(message):
    """Print an error and exit non-zero."""
    print("cdist-graph: {}".format(message), file=sys.stderr)
    sys.exit(1)


def cache_entries():
    """Yield (host, cache_path) for every cache directory that has a host."""
    try:
        scanner = os.scandir(CACHE_DIR)
    except OSError:
        return
    with scanner:
        for entry in scanner:
            if not entry.is_dir(follow_symlinks=False):
                continue
            hostfile = os.path.join(entry.path, "target_host")
            if not os.path.isfile(hostfile):
                continue
            try:
                with open(hostfile, encoding="utf-8") as handle:
                    host = handle.read().strip()
            except OSError:
                continue
            if host:
                yield host, entry.path


def find_cache(host):
    """Return the newest cache directory for host, or None."""
    best = None
    for cached_host, path in cache_entries():
        if cached_host != host:
            continue
        try:
            age = os.path.getmtime(os.path.join(path, "object"))
        except OSError:
            age = 0
        if best is None or age > best[0]:
            best = (age, path)
    return best[1] if best else None


def normalize(name):
    """cdist names an object without an id as "__type/"; drop the trailing /."""
    return name[:-1] if name.endswith("/") else name


def load_graph(cache):
    """Return (nodes, require_edges, autorequire_edges) from a cache dir.

    nodes maps object name -> type. Edges are (dependent, dependency)
    pairs, i.e. the first object requires the second.
    """
    try:
        with open(os.path.join(cache, "object_marker"), encoding="utf-8") as handle:
            marker = handle.read().strip()
    except OSError as error:
        fail("cannot read object marker in {}: {}".format(cache, error))

    objroot = os.path.join(cache, "object")
    nodes = {}
    edges = {"require": [], "autorequire": []}
    for dirpath, _dirnames, _filenames in os.walk(objroot):
        if os.path.basename(dirpath) != marker:
            continue
        obj = normalize(os.path.relpath(os.path.dirname(dirpath), objroot))
        nodes[obj] = obj.split("/", 1)[0]
        for kind in edges:
            path = os.path.join(dirpath, kind)
            if not os.path.isfile(path):
                continue
            seen = set()
            with open(path, encoding="utf-8") as handle:
                for line in handle:
                    dep = normalize(line.strip())
                    if dep and dep not in seen:
                        seen.add(dep)
                        edges[kind].append((obj, dep))
    return nodes, edges["require"], edges["autorequire"]


def connected(nodes, require, autorequire, focus, direction):
    """Return the subset of nodes connected to focus in the requested direction."""
    forward = defaultdict(set)   # a -> things a requires
    backward = defaultdict(set)  # b -> things that require b
    for dependent, dependency in require + autorequire:
        forward[dependent].add(dependency)
        backward[dependency].add(dependent)

    def walk(adjacency):
        keep = {focus}
        queue = deque([focus])
        while queue:
            current = queue.popleft()
            for other in adjacency[current]:
                if other not in keep:
                    keep.add(other)
                    queue.append(other)
        return keep

    if direction == "up":
        return walk(forward)
    if direction == "down":
        return walk(backward)
    return walk(forward) | walk(backward)


def restrict(nodes, require, autorequire, keep):
    """Drop everything not in keep from nodes and edges."""
    nodes = {n: t for n, t in nodes.items() if n in keep}
    require = [(a, b) for a, b in require if a in keep and b in keep]
    autorequire = [(a, b) for a, b in autorequire if a in keep and b in keep]
    return nodes, require, autorequire


def dot_quote(text):
    """Quote a Graphviz identifier, escaping backslashes and quotes."""
    text = text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")
    return '"{}"'.format(text)


def node_label(name):
    """Short label: object id without the leading type."""
    return name.split("/", 1)[1] if "/" in name else name


def edge_attrs(kinds):
    """Graphviz attributes for an edge that carries the given kinds.

    require drives the ranking. autorequire is drawn but not allowed to
    influence it, otherwise Graphviz' ranking explodes on big fan-ins
    (e.g. __le and ~200 cert files).
    """
    if "require" in kinds:
        return "style=solid"
    return "style=dashed, constraint=false"


def compute_levels(nodes, edges):
    """Longest-path level of every node: 0 = depends on nothing.

    Nodes at the same level can run in parallel. Kahn's algorithm over the
    DAG formed by the dependency edges.
    """
    deps = defaultdict(set)
    for dependent, dependency in edges:
        if dependency in nodes and dependent in nodes:
            deps[dependent].add(dependency)
    dependents = defaultdict(set)
    for name in nodes:
        for dependency in deps[name]:
            dependents[dependency].add(name)

    level = {name: 0 for name in nodes}
    remaining = {name: len(deps[name]) for name in nodes}
    queue = deque(name for name in nodes if remaining[name] == 0)
    while queue:
        name = queue.popleft()
        for other in dependents[name]:
            if level[name] + 1 > level[other]:
                level[other] = level[name] + 1
            remaining[other] -= 1
            if remaining[other] == 0:
                queue.append(other)
    return level


def collapse_chains(nodes, require):
    """Merge runs of pass-through objects (one require in, one out) together.

    This is what keeps the tree readable: the __le type alone produces a
    ~200-object require chain (cert -> dir -> next cert -> ...).
    """
    deps = defaultdict(set)
    dependents = defaultdict(set)
    for dependent, dependency in require:
        if dependent in nodes and dependency in nodes:
            deps[dependent].add(dependency)
            dependents[dependency].add(dependent)

    parent = {name: name for name in nodes}

    def find(name):
        while parent[name] != name:
            parent[name] = parent[parent[name]]
            name = parent[name]
        return name

    def union(one, two):
        root_one, root_two = find(one), find(two)
        if root_one != root_two:
            parent[root_two] = root_one

    def linear(name):
        return len(deps[name]) == 1 and len(dependents[name]) == 1

    for name in nodes:
        if linear(name):
            only_dep = next(iter(deps[name]))
            if linear(only_dep):
                union(name, only_dep)

    members = defaultdict(list)
    for name in nodes:
        members[find(name)].append(name)
    return find, members


def build_tree_dot(nodes, require, autorequire, collapse, rankdir="LR",
                   invert=False):
    """Layered top-down view: one rank per level, chains collapsed."""
    label = {}
    tooltip = {}
    if collapse:
        find, members = collapse_chains(nodes, require)
        collapsed_nodes = {}
        for root, group in members.items():
            collapsed_nodes[root] = nodes[group[0]]
        require = [(find(a), find(b)) for a, b in require
                   if a in nodes and b in nodes and find(a) != find(b)]
        autorequire = [(find(a), find(b)) for a, b in autorequire
                       if a in nodes and b in nodes and find(a) != find(b)]
        for root, group in members.items():
            if len(group) == 1:
                name = group[0]
                label[root] = node_label(name)
                tooltip[root] = name
            else:
                types = Counter(m.split("/", 1)[0] for m in group)
                parts = ", ".join("{} x{}".format(t, c)
                                  for t, c in types.most_common(3))
                label[root] = "{} chained: {}".format(len(group), parts)
                shown = sorted(group)
                tooltip[root] = ", ".join(shown[:40])
                if len(shown) > 40:
                    tooltip[root] += " ..."
        nodes = collapsed_nodes

    level = compute_levels(nodes, require + autorequire)
    if invert:
        # Put the objects that depend on something at the top and the objects
        # they depend on (ultimately the primitives) below: reverse the ranks
        # and point the arrows from an object to what it depends on.
        deepest = max(level.values()) if level else 0
        level = {name: deepest - rank for name, rank in level.items()}
    by_level = defaultdict(list)
    for name in nodes:
        by_level[level[name]].append(name)

    kinds = defaultdict(set)
    if invert:
        for dependent, dependency in require:
            kinds[(dependent, dependency)].add("require")
        for dependent, dependency in autorequire:
            kinds[(dependent, dependency)].add("autorequire")
    else:
        for dependent, dependency in require:
            kinds[(dependency, dependent)].add("require")
        for dependent, dependency in autorequire:
            kinds[(dependency, dependent)].add("autorequire")

    lines = [
        "digraph cdist {",
        "  rankdir={};".format(rankdir),
        "  compound=true;",
        "  node [{}];".format(TREE_NODE_ATTR),
        "  edge [{}];".format(TREE_EDGE_ATTR),
    ]
    for lvl in sorted(by_level):
        lines.append("  { rank=same;")
        names = sorted(by_level[lvl],
                       key=lambda n: (label.get(n, node_label(n)), n))
        for name in names:
            lines.append("    {} [label={}, tooltip={}];".format(
                dot_quote(name),
                dot_quote(label.get(name, node_label(name))),
                dot_quote(tooltip.get(name, name))))
        lines.append("  }")

    for (source, target), kind_set in sorted(kinds.items()):
        lines.append("  {} -> {} [{}];".format(
            dot_quote(source), dot_quote(target), edge_attrs(kind_set)))

    lines.append("}")
    return "\n".join(lines), len(nodes), (max(by_level) + 1 if by_level else 0)


def build_object_dot(nodes, require, autorequire, rankdir):
    """Render every object as a node, clustered per type."""
    by_type = defaultdict(list)
    for name, type_name in nodes.items():
        by_type[type_name].append(name)

    lines = [
        "digraph cdist {",
        "  rankdir={};".format(rankdir),
        "  compound=true;",
        "  node [{}];".format(NODE_ATTR),
        "  edge [{}];".format(EDGE_ATTR),
    ]

    for index, type_name in enumerate(sorted(by_type)):
        lines.append("  subgraph cluster_{} {{".format(index))
        lines.append("    label={};".format(dot_quote(type_name)))
        lines.append('    style="rounded,dashed"; color="#bbbbbb"; fontsize=11;')
        for name in sorted(by_type[type_name]):
            lines.append("    {} [label={}, tooltip={}];".format(
                dot_quote(name), dot_quote(node_label(name)), dot_quote(name)))
        lines.append("  }")

    # Edge dependency -> dependent, so arrows follow execution order.
    kinds = defaultdict(set)
    for dependent, dependency in require:
        if dependency in nodes and dependent in nodes:
            kinds[(dependency, dependent)].add("require")
    for dependent, dependency in autorequire:
        if dependency in nodes and dependent in nodes:
            kinds[(dependency, dependent)].add("autorequire")

    for (source, target), kind_set in sorted(kinds.items()):
        lines.append("  {} -> {} [{}];".format(
            dot_quote(source), dot_quote(target), edge_attrs(kind_set)))

    lines.append("}")
    return "\n".join(lines)


def build_type_dot(nodes, require, autorequire, rankdir):
    """Collapse objects to their type and aggregate the edge counts."""
    counts = defaultdict(int)
    for type_name in nodes.values():
        counts[type_name] += 1

    kinds = defaultdict(lambda: {"require": 0, "autorequire": 0})
    for dependent, dependency in require:
        if dependency in nodes and dependent in nodes:
            kinds[(nodes[dependency], nodes[dependent])]["require"] += 1
    for dependent, dependency in autorequire:
        if dependency in nodes and dependent in nodes:
            kinds[(nodes[dependency], nodes[dependent])]["autorequire"] += 1

    lines = [
        "digraph cdist {",
        "  rankdir={};".format(rankdir),
        "  compound=true;",
        "  node [{}];".format(NODE_ATTR.replace("fontsize=10", "fontsize=11")),
        "  edge [{}];".format(EDGE_ATTR),
    ]
    for type_name in sorted(counts):
        label = "{} ({})".format(type_name, counts[type_name])
        lines.append("  {} [label={}];".format(
            dot_quote(type_name), dot_quote(label)))

    for (source, target), count in sorted(kinds.items()):
        parts = []
        if count["require"]:
            parts.append(str(count["require"]))
        if count["autorequire"]:
            parts.append("{} ar".format(count["autorequire"]))
        attrs = "label={}, {}".format(
            dot_quote(" / ".join(parts)),
            edge_attrs({k for k, v in count.items() if v}))
        lines.append("  {} -> {} [{}];".format(
            dot_quote(source), dot_quote(target), attrs))

    lines.append("}")
    return "\n".join(lines)


def render_svg(dot_source):
    """Run Graphviz dot to turn DOT into SVG."""
    dot_binary = shutil.which("dot")
    if not dot_binary:
        fail("graphviz 'dot' not found in PATH (install graphviz)")
    result = subprocess.run(
        [dot_binary, "-Tsvg"],
        input=dot_source.encode("utf-8"),
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        fail("dot failed: {}".format(result.stderr.decode("utf-8", "replace").strip()))
    return result.stdout.decode("utf-8")


HTML_TEMPLATE = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
