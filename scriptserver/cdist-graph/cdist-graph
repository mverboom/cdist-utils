                font-family: Helvetica, Arial, sans-serif; background: #fff; }}
  #toolbar {{ position: fixed; top: 0; left: 0; right: 0; z-index: 2;
             padding: 6px 10px; background: #eeeeee;
             border-bottom: 1px solid #cccccc; font-size: 13px; }}
  #toolbar button {{ font-size: 13px; margin-left: 4px; }}
  #stage {{ position: absolute; top: 39px; left: 0; right: 0; bottom: 0;
           overflow: hidden; cursor: grab; }}
  #stage.dragging {{ cursor: grabbing; }}
  #stage svg {{ max-width: none; transform-origin: 0 0; }}
  .sep {{ margin: 0 8px; color: #999999; }}
</style>
</head>
<body>
<div id="toolbar">
  <strong>{host}</strong>
  <span class="sep">|</span>{summary}
  <span class="sep">|</span>cache: {cache_age}
  <span class="sep">|</span>{scope}
  <span class="sep">|</span>
  <span style="border: 1px solid #333333; border-top: 2px solid #333333;
              padding: 0 5px;">require</span>
  <span style="border: 1px solid #333333; border-top: 2px dashed #333333;
              padding: 0 5px;">autorequire</span>
  <span class="sep">|</span>
  <button type="button" data-zoom="1.25">zoom in</button>
  <button type="button" data-zoom="0.8">zoom out</button>
  <button type="button" data-zoom="0">reset</button>
  <span class="sep">|</span>drag to pan, scroll to zoom
</div>
<div id="stage">
{svg}
</div>
<script>
(function () {{
  var stage = document.getElementById("stage");
  var svg = stage.querySelector("svg");
  var scale = 1, x = 0, y = 0, dragging = false, startX = 0, startY = 0;
  function apply() {{
    svg.style.transform = "translate(" + x + "px," + y + "px) scale(" + scale + ")";
  }}
  stage.addEventListener("wheel", function (event) {{
    event.preventDefault();
    var box = stage.getBoundingClientRect();
    var px = event.clientX - box.left, py = event.clientY - box.top;
    var factor = event.deltaY < 0 ? 1.15 : 1 / 1.15;
    x = px - (px - x) * factor;
    y = py - (py - y) * factor;
    scale *= factor;
    apply();
  }}, {{passive: false}});
  stage.addEventListener("mousedown", function (event) {{
    dragging = true; stage.classList.add("dragging");
    startX = event.clientX - x; startY = event.clientY - y;
  }});
  window.addEventListener("mousemove", function (event) {{
    if (!dragging) return;
    x = event.clientX - startX; y = event.clientY - startY; apply();
  }});
  window.addEventListener("mouseup", function () {{
    dragging = false; stage.classList.remove("dragging");
  }});
  document.querySelectorAll("[data-zoom]").forEach(function (button) {{
    button.addEventListener("click", function () {{
      var factor = parseFloat(button.dataset.zoom);
      if (factor === 0) {{ scale = 1; x = 0; y = 0; }} else {{ scale *= factor; }}
      apply();
    }});
  }});
  apply();
}})();
</script>
</body>
</html>
"""


def human_age(seconds):
    """Format an age in seconds as a short human string."""
    seconds = int(max(0, seconds))
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return "{}{} ago".format(seconds // size, unit)
    return "{}s ago".format(seconds)


def build_html(host, cache, dot_source, summary, scope):
    """Wrap the rendered SVG in the interactive page."""
    try:
        age = human_age(os.path.getmtime(os.path.join(cache, "object")))
    except OSError:
        age = "unknown"
    return HTML_TEMPLATE.format(
        host=html.escape(host),
        svg=render_svg(dot_source),
        summary=html.escape(summary),
        cache_age=html.escape(age),
        scope=html.escape(scope),
    )


def parse_args(argv):
    """Parse the command line."""
    parser = argparse.ArgumentParser(
        prog="cdist-graph",
        description="Visualise a host's cdist dependency graph from a cached run.")
    parser.add_argument("host", nargs="?", help="host name (fqdn / cache name)")
    parser.add_argument("--view", choices=("tree", "types", "objects"),
                        default="tree",
                        help="tree = layered levels (default); types = per-type "
                             "network; objects = per-object network")
    parser.add_argument("--orientation", choices=("lr", "tb"), default="lr",
                        help="tree view: lr = levels left-to-right (default), "
                             "tb = levels top-to-bottom")
    parser.add_argument("--order", choices=("dependents", "primitives"),
                        default="dependents",
                        help="tree view: dependents = objects that depend on "
                             "something first (default); primitives = objects "
                             "that depend on nothing first")
    parser.add_argument("--no-collapse", action="store_true",
                        help="tree view: do not merge pass-through chains")
    parser.add_argument("--focus", metavar="OBJECT",
                        help="object to centre on, e.g. __file/etc/motd")
    parser.add_argument("--direction", choices=("both", "up", "down"),
                        default="both",
                        help="with --focus: up=its dependencies, down=dependents")
    parser.add_argument("--types", metavar="TYPE", action="append", default=[],
                        help="object type to keep (repeatable)")
    parser.add_argument("--dot", action="store_true", help="print raw DOT")
    parser.add_argument("--svg", action="store_true", help="print raw SVG")
    parser.add_argument("--list-hosts", action="store_true",
                        help="print hosts that have a cached run")
    parser.add_argument("--list-types", action="store_true",
                        help="print object types of the given host")
    parser.add_argument("--list-objects", action="store_true",
                        help="print object names of the given host")
    return parser.parse_args(argv)


def main(argv):
    """Entry point."""
    args = parse_args(argv)

    if args.list_hosts:
        for host in sorted({h for h, _ in cache_entries()}):
            print(host)
        return 0

    if not args.host:
        fail("a host is required")

    cache = find_cache(args.host)
    if not cache:
        fail("no cached cdist run for host '{}'".format(args.host))

    all_nodes, require, autorequire = load_graph(cache)

    if args.list_types:
        print("\n".join(sorted({t for t in all_nodes.values()})))
        return 0
    if args.list_objects:
        print("\n".join(sorted(all_nodes)))
        return 0

    nodes = all_nodes
    scope = "all objects"
    keep = None
    if args.types:
        types = {t for value in args.types for t in value.split(",") if t}
        keep = {n for n, t in nodes.items() if t in types}
        scope = "types: {}".format(",".join(sorted(types)))
    if args.focus:
        if args.focus not in nodes:
            fail("object '{}' not in the graph".format(args.focus))
        focused = connected(nodes, require, autorequire, args.focus, args.direction)
        keep = focused if keep is None else (keep & focused)
        scope = "focus: {} ({})".format(args.focus, args.direction)
    if keep is not None:
        nodes, require, autorequire = restrict(nodes, require, autorequire, keep)

    edge_count = len({(b, a) for a, b in require} |
                     {(b, a) for a, b in autorequire})

    if args.view == "tree":
        dot_source, shown, levels = build_tree_dot(
            nodes, require, autorequire, not args.no_collapse,
            args.orientation.upper(), args.order == "dependents")
        detail = "uncollapsed" if args.no_collapse else "chains collapsed"
        summary = "{} objects, {} dependencies, {} levels ({}, {}, {} first)".format(
            shown, edge_count, levels, detail, args.orientation, args.order)
    elif args.view == "types":
        dot_source = build_type_dot(nodes, require, autorequire, "LR")
        summary = "{} types, {} type dependencies".format(
            len({t for t in nodes.values()}), edge_count)
    else:
        dot_source = build_object_dot(nodes, require, autorequire, "TB")
        summary = "{} objects, {} dependencies".format(len(nodes), edge_count)

    if args.dot:
        print(dot_source)
        return 0
    if args.svg:
        print(render_svg(dot_source))
        return 0

    print(build_html(args.host, cache, dot_source, summary, scope))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
