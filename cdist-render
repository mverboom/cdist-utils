#!/usr/bin/env python3
#
# cdist-render
#
# Render the cdist object tree for every host without touching any host:
# global explorer output is replayed from the recorded explorer data, the
# remote side is a local stub, and cdist runs with -n so no code is executed.
#
# The rendered trees are the baseline for impact analysis: render before a
# change, render after it, and diff the two.
#
# See CDIST-RENDER.md.

"""Render cdist object trees offline and diff them."""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import re
import shutil
import subprocess
import sys
import time
from collections import defaultdict
from pathlib import Path

VERSION = "0.1.0"

FAKE_EXEC = """#!/bin/sh
# Stand-in for ssh: drop the host argument and run the rest locally.
shift
cmd="$*"

# Type explorers describe target state that is not recorded anywhere.
case "$cmd" in
*conf/type/*/explorer/*)
   rest="${cmd##*conf/type/}"
   type="${rest%%/*}"
   sub="${rest#*/}"
   name="${sub#explorer/}"
   name="${name%%[\\' ]*}"
   __object_id=$(printf '%s' "$cmd" | sed -n 's/.*__object_id=\\([^ ;]*\\).*/\\1/p')
   __object=$(printf '%s' "$cmd" | sed -n 's/.*__object=\\([^ ;]*\\).*/\\1/p')
   export __object_id __object
   if test -f "$STUBS/$type/$name"; then
      exec "$STUBS/$type/$name"
   fi
   # Without a stub, assume the target already matches the requested state:
   # the object then generates no code and needs no target state at all,
   # which is what a rendered tree should show.
   if test "$name" = "state" && test -f "$__object/parameter/state"; then
      exec cat "$__object/parameter/state"
   fi
   exit 0
   ;;
esac
exec /bin/sh -c "$cmd"
"""

FAKE_COPY = """#!/bin/bash
# Stand-in for scp: the last argument is "host:path", copy locally instead.
set -eu
argv=( "$@" )
dest="${argv[-1]}"
unset 'argv[-1]'
dest="${dest#*:}"
cp -a -- "${argv[@]}" "$dest"
"""

EXPLORER_REPLAY = """#!/bin/sh
# Replay the recorded explorer output of the target host. CDIST_EXPLORE points
# at a scratch directory (cdist writes the explorer output there), the data
# that is replayed lives in CDIST_REPLAY_EXPLORE.
name="${0##*/}"
for candidate in "$__target_host" "$__target_fqdn" "$__target_hostname"; do
   file="${CDIST_REPLAY_EXPLORE:-$CDIST_EXPLORE}/$candidate/$name"
   if test -f "$file"; then
      exec cat "$file"
   fi
done
exit 0
"""

ERROR_LINE = re.compile(r"^(ERROR|error):? ?(.*)$")
# cdist sets e.g. --source to a path inside the run's object directory; that
# path contains the run's random object marker and the temporary work dir, so
# it has to be normalised or every render would look like a change.
OBJECT_PATH = re.compile(r"/\.cdist-[^/]+/(.*)$")


def build_parser() -> argparse.ArgumentParser:
    """Return the command line parser."""
    parser = argparse.ArgumentParser(
        prog="cdist-render",
        description="Render cdist object trees offline and diff them.",
        epilog="The 'render' command never contacts a host and never executes "
               "type code.",
    )
    parser.add_argument("--version", action="version", version=VERSION)
    sub = parser.add_subparsers(dest="command", required=True)

    render = sub.add_parser("render", help="render hosts into the snapshot dir")
    render.add_argument("hosts", nargs="*", help="hosts to render")
    render.add_argument("-a", "--all", action="store_true",
                        help="render every host that has explorer data")
    render.add_argument("--keep-work", action="store_true",
                        help="keep the per host work directory (cache, logs) "
                             "after a successful render")
    render.add_argument("-j", "--jobs", type=int, default=1, metavar="N",
                        help="render up to N hosts in parallel")
    common(render)

    diff = sub.add_parser("diff", help="compare two snapshot directories")
    diff.add_argument("baseline", type=Path, help="snapshot directory to diff "
                      "against")
    diff.add_argument("current", nargs="?", type=Path, default=None,
                      help="snapshot directory to compare (default: --snapshot"
                           "-dir)")
    diff.add_argument("--json", action="store_true",
                      help="write the differences as json")
    diff.add_argument("-q", "--quiet", action="store_true",
                      help="only print the summary")
    diff.add_argument("--verbose", action="store_true",
                      help="also list unchanged hosts")
    common(diff)
    return parser


def common(parser: argparse.ArgumentParser) -> None:
    """Add the options shared by render and diff."""
    parser.add_argument("-c", "--config-dir", action="append", default=[],
                        type=Path, metavar="DIR",
                        help="configuration directory (repeatable, later wins)")
    parser.add_argument("-u", "--upstream-conf", type=Path, metavar="DIR",
                        help="conf directory of the cdist installation")
    parser.add_argument("-e", "--explore", type=Path, metavar="DIR",
                        help="recorded explorer output (default CDIST_EXPLORE)")
    parser.add_argument("-w", "--work-dir", type=Path, metavar="DIR",
                        default=Path("/tmp/cdist-render"),
                        help="scratch directory (default /tmp/cdist-render)")
    parser.add_argument("-s", "--snapshot-dir", type=Path, metavar="DIR",
                        default=Path("rendered"),
                        help="where the rendered trees are kept (default "
                             "./rendered)")
    parser.add_argument("-S", "--stubs", type=Path, metavar="DIR",
                        default=None,
                        help="directory with type explorer stubs (default: "
                             "cdist-render-stubs next to the script, else "
                             "<work-dir>/stubs)")
    parser.add_argument("--cdist", default="cdist", metavar="CMD",
                        help="cdist binary to use")


def find_upstream(explicit: Path | None) -> Path | None:
    """Locate the conf directory shipped with the cdist installation."""
    candidates: list[Path] = []
    if explicit:
        candidates.append(explicit)
    for variable in ("CDIST_UPSTREAM_CONF", "CDIST_INSTALL"):
        value = os.environ.get(variable)
        if value:
            candidates += [Path(value) / "cdist" / "conf", Path(value) / "conf"]
    for candidate in candidates:
        if (candidate / "type").is_dir():
            return candidate
    return None


def resolve(args: argparse.Namespace) -> dict[str, object]:
    """Resolve the locations used by both commands."""
    config_dirs = list(args.config_dir) or [
        Path(os.environ.get("CDIST_CONFIG_DIR") or Path.home() / "config")
    ]
    explore = args.explore or (
        Path(os.environ["CDIST_EXPLORE"]) if os.environ.get("CDIST_EXPLORE")
        else None)
    bundled = Path(__file__).resolve().parent / "cdist-render-stubs"
    stubs = args.stubs or (bundled if bundled.is_dir()
                           else args.work_dir / "stubs")
    inventory = Path(os.environ.get("CDIST_INVENTORY") or
                     Path.home() / ".cdist" / "inventory")
    exclude = Path(os.environ["HOME"]) / ".cdist-fullrun-exclude"
    return {
        "config_dirs": [path.resolve() for path in config_dirs],
        "upstream": find_upstream(args.upstream_conf),
        "explore": explore,
        "work": args.work_dir,
        "home": args.work_dir / "home",
        "snapshot": args.snapshot_dir,
        "stubs": stubs,
        "cdist": args.cdist,
        "inventory": inventory if inventory.is_dir() else None,
        "exclude": exclude if exclude.is_file() else None,
    }


def explorer_names(context: dict[str, object]) -> list[str]:
    """Return the effective global explorer names."""
    names: set[str] = set()
    for base in [context["upstream"], *context["config_dirs"]]:
        if base and (base / "explorer").is_dir():
            names |= {entry.name for entry in (base / "explorer").iterdir()}
    return sorted(names)


def prepare_work(context: dict[str, object]) -> None:
    """Create the wrappers and the explorer replay overlay."""
    work = context["work"]
    bin_dir = work / "bin"
    overlay = work / "overlay" / "explorer"
    overlay.mkdir(parents=True, exist_ok=True)
    bin_dir.mkdir(parents=True, exist_ok=True)
    context["stubs"].mkdir(parents=True, exist_ok=True)
    home = context["home"]
    (home / ".cdist").mkdir(parents=True, exist_ok=True)
    # Types like __cdist-poll write the cdist user's own ~/.ssh/authorized_keys
    # while their manifest runs; that has to land in the sandbox as well.
    (home / ".ssh").mkdir(mode=0o700, parents=True, exist_ok=True)
    # cdist caches per host under $HOME/.cdist/cache: keep that in the work
    # directory, but let the run see the inventory and the full-run exclusions.
    if context["inventory"]:
        link = home / ".cdist" / "inventory"
        if not link.exists():
            link.symlink_to(context["inventory"])
    if context["exclude"]:
        link = home / ".cdist-fullrun-exclude"
        if not link.exists():
            link.symlink_to(context["exclude"])
    (bin_dir / "fake-exec").write_text(FAKE_EXEC)
    (bin_dir / "fake-exec").chmod(0o755)
    (bin_dir / "fake-copy").write_text(FAKE_COPY)
    (bin_dir / "fake-copy").chmod(0o755)
    for name in explorer_names(context):
        script = overlay / name
        if not script.exists() or script.read_text() != EXPLORER_REPLAY:
            script.write_text(EXPLORER_REPLAY)
            script.chmod(0o755)


def render_command(context: dict[str, object], host: str) -> list[str]:
    """Build the cdist command line for one host."""
    work = context["work"] / host
    command = [
        str(context["cdist"]), "config",
        "-n",
        "--remote-exec", str(context["work"] / "bin" / "fake-exec"),
        "--remote-copy", str(context["work"] / "bin" / "fake-copy"),
        "-r", str(work / "remote"),
        "-o", str(work / "out"),
        "-C", host,
    ]
    for config_dir in context["config_dirs"]:
        command += ["-c", str(config_dir)]
    command += ["-c", str(context["work"] / "overlay"), host]
    return command


def render_environment(context: dict[str, object], host: str) -> \
        dict[str, str]:
    """Return the environment for a cdist run.

    HOME points into the work directory so cdist keeps its cache there, and
    CDIST_EXPLORE points at a scratch directory: the initial manifest writes
    the explorer output to $CDIST_EXPLORE/$fqdn and must not touch the
    recorded data that is being replayed.
    """
    env = dict(os.environ)
    env["CDIST_BETA"] = "1"
    env["STUBS"] = str(context["stubs"])
    env["HOME"] = str(context["home"])
    if context["explore"]:
        env["CDIST_REPLAY_EXPLORE"] = str(context["explore"])
    env["CDIST_EXPLORE"] = str(context["work"] / host / "explore-out")
    return env


def find_tree(context: dict[str, object], host: str, ok: bool) -> Path | None:
    """Return the directory holding the objects of the run that just finished.

    A successful run moves its data into the cache; a failed one leaves it in
    the output directory. The cache is only trusted when the run succeeded,
    otherwise the previous render's data would be read again.
    """
    work = context["work"] / host
    candidates: list[Path] = []
    if ok:
        candidates.append(context["home"] / ".cdist" / "cache" / host)
    candidates += sorted((work / "out").glob("*/data"))
    for candidate in candidates:
        if (candidate / "object_marker").is_file():
            return candidate
    return None


def parse_tree(data: Path) -> dict[str, object]:
    """Convert a cdist cache directory into a stable, comparable structure."""
    marker = (data / "object_marker").read_text().strip()
    objects: list[dict[str, object]] = []
    for path in sorted((data / "object").rglob(marker)):
        # cdist keeps the object data in a directory named after the run's
        # object marker; an older layout keeps it next to the marker file.
        holder = path if path.is_dir() else path.parent
        object_dir = path.parent
        relative = object_dir.relative_to(data / "object").parts
        if not relative:
            continue
        parameters: dict[str, str] = {}
        parameter_path = holder / "parameter"
        if parameter_path.is_dir():
            for entry in sorted(parameter_path.iterdir()):
                if entry.is_file():
                    parameters[entry.name] = normalize_value(
                        entry.read_text(errors="replace").strip())
        objects.append({
            "name": "/".join(relative),
            "parameters": parameters,
            "require": read_list(holder / "require"),
            "autorequire": read_list(holder / "autorequire"),
            "source": read_text(holder / "source"),
            "state": read_text(holder / "state"),
        })
    return {
        "objects": objects,
        "order": read_order(data),
        "messages": sorted(read_list(data / "messages")),
    }


def normalize_value(value: str) -> str:
    """Replace run specific object paths in a parameter value."""
    if "/.cdist-" not in value:
        return value
    parts = []
    for line in value.splitlines():
        match = OBJECT_PATH.search(line)
        parts.append(f"<object>/{match.group(1)}" if match else line)
    return "\n".join(parts)


def read_list(path: Path) -> list[str]:
    """Read a file with one entry per line."""
    if not path.is_file():
        return []
    return sorted(line.strip() for line in
                  path.read_text(errors="replace").splitlines() if line.strip())


def read_text(path: Path) -> str:
    """Read a file, returning an empty string when it is absent."""
    if not path.is_file():
        return ""
    return path.read_text(errors="replace").strip()


def read_order(data: Path) -> list[str]:
    """Read the typeorder file, the order in which cdist executes types."""
    if not (data / "typeorder").is_file():
        return []
    return [line.strip() for line in
            (data / "typeorder").read_text(errors="replace").splitlines()
            if line.strip()]


def first_error(log: Path) -> str:
    """Return the first error message of a cdist run."""
    if not log.is_file():
        return ""
    for line in log.read_text(errors="replace").splitlines():
        match = ERROR_LINE.match(line.strip())
        if match:
            return match.group(2).strip()
    return ""


def render_host(context: dict[str, object], host: str,
                keep_work: bool = False) -> dict[str, object]:
    """Render one host and write its snapshot file."""
    snapshot_dir = context["snapshot"]
    snapshot_dir.mkdir(parents=True, exist_ok=True)
    work = context["work"] / host
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True, exist_ok=True)
    cached = context["home"] / ".cdist" / "cache" / host
    shutil.rmtree(cached, ignore_errors=True)
    log = work / "render.log"
    started = time.time()
    with log.open("w") as handle:
        result = subprocess.run(render_command(context, host),
                                env=render_environment(context, host),
                                stdout=handle,
                                stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
    data = find_tree(context, host, result.returncode == 0)
    snapshot: dict[str, object] = {
        "host": host,
        "ok": result.returncode == 0,
        "error": first_error(log) if result.returncode else "",
        "seconds": round(time.time() - started, 2),
    }
    if data:
        snapshot.update(parse_tree(data))
    else:
        snapshot.update({"objects": [], "order": [], "messages": []})
    (snapshot_dir / f"{host}.json").write_text(
        json.dumps(snapshot, indent=1, sort_keys=True) + "\n")
    if snapshot["ok"] and not keep_work:
        shutil.rmtree(work, ignore_errors=True)
    return snapshot


def command_render(context: dict[str, object], args: argparse.Namespace) -> int:
    """Render the requested hosts."""
    prepare_work(context)
    hosts = list(args.hosts)
    if args.all or not hosts:
        explore = context["explore"]
        if not explore or not explore.is_dir():
            print("cdist-render: no explorer data available, cannot render all")
            return 1
        hosts = sorted(entry.name for entry in explore.iterdir()
                       if entry.is_dir() and entry.name != ".git")
    failures = 0
    snapshots: list[dict[str, object]] = []
    if args.jobs > 1 and len(hosts) > 1:
        with concurrent.futures.ThreadPoolExecutor(args.jobs) as pool:
            futures = [pool.submit(render_host, context, host, args.keep_work)
                       for host in hosts]
            for future in concurrent.futures.as_completed(futures):
                snapshot = future.result()
                snapshots.append(snapshot)
                failures += report_host(snapshot)
    else:
        for host in hosts:
            snapshot = render_host(context, host, args.keep_work)
            snapshots.append(snapshot)
            failures += report_host(snapshot)
    write_index(context)
    print(f"cdist-render: rendered {len(hosts)} hosts into "
          f"{context['snapshot']}, {failures} failed")
    return 1 if failures else 0


def report_host(snapshot: dict[str, object]) -> int:
    """Print one rendered host and return 1 when it failed."""
    print(f"{snapshot['host']}: {'ok' if snapshot['ok'] else 'FAILED'}, "
          f"{len(snapshot['objects'])} objects, {snapshot['seconds']}s"
          + (f" - {snapshot['error']}" if snapshot["error"] else ""),
          flush=True)
    return 0 if snapshot["ok"] else 1


def config_revision(path: Path) -> str:
    """Return the git revision of a configuration directory."""
    try:
        result = subprocess.run(["git", "-C", str(path), "rev-parse",
                                 "--short", "HEAD"], capture_output=True,
                                text=True, stdin=subprocess.DEVNULL)
    except OSError:
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def write_index(context: dict[str, object]) -> None:
    """Write the snapshot index: when and from what it was rendered."""
    index = {
        "rendered": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "config_dirs": [{"path": str(path),
                         "revision": config_revision(path)}
                        for path in context["config_dirs"]],
        "upstream": str(context["upstream"] or ""),
        "explore": str(context["explore"] or ""),
    }
    (context["snapshot"] / "index.json").write_text(
        json.dumps(index, indent=1, sort_keys=True) + "\n")


def load_snapshots(directory: Path) -> dict[str, dict[str, object]]:
    """Load every snapshot in a directory."""
    result: dict[str, dict[str, object]] = {}
    if not directory.is_dir():
        return result
    for path in sorted(directory.glob("*.json")):
        if path.name == "index.json":
            continue
        try:
            snapshot = json.loads(path.read_text())
        except json.JSONDecodeError:
            continue
        result[snapshot.get("host", path.stem)] = snapshot
    return result


def diff_host(before: dict[str, object], after: dict[str, object]) -> \
        dict[str, list[str]]:
    """Compare two rendered trees and describe the differences."""
    changes: dict[str, list[str]] = defaultdict(list)
    if before.get("ok") != after.get("ok"):
        changes["status"].append(
            f"run status changed: {'ok' if before.get('ok') else 'failed'} -> "
            f"{'ok' if after.get('ok') else 'failed'} ({after.get('error', '')})")
    old = {obj["name"]: obj for obj in before.get("objects", [])}
    new = {obj["name"]: obj for obj in after.get("objects", [])}
    for name in sorted(new.keys() - old.keys()):
        changes["added"].append(name)
    for name in sorted(old.keys() - new.keys()):
        changes["removed"].append(name)
    for name in sorted(old.keys() & new.keys()):
        if old[name]["parameters"] != new[name]["parameters"]:
            changes["parameters"].append(
                f"{name}: {describe_parameters(old[name], new[name])}")
        if set(old[name]["require"]) != set(new[name]["require"]):
            changes["require"].append(
                f"{name}: require {sorted(set(old[name]['require']))} -> "
                f"{sorted(set(new[name]['require']))}")
        if set(old[name]["autorequire"]) != set(new[name]["autorequire"]):
            changes["autorequire"].append(name)
    old_order = [name for name in before.get("order", []) if name in new]
    new_order = [name for name in after.get("order", []) if name in old]
    if old_order != new_order and len(old_order) > 1:
        moved = [f"{name} ({old_order.index(name)} -> {new_order.index(name)})"
                 for name in new_order if old_order.index(name) !=
                 new_order.index(name)]
        changes["order"].append(
            f"{len(moved)} of {len(old_order)} common objects change position"
            + (f", e.g. {', '.join(moved[:5])}" if moved else ""))
    return changes


def describe_parameters(old: dict[str, object], new: dict[str, object]) -> str:
    """Describe the parameter differences of one object."""
    before, after = old["parameters"], new["parameters"]
    parts = []
    for key in sorted(after.keys() - before.keys()):
        parts.append(f"+{key}={after[key]}")
    for key in sorted(before.keys() - after.keys()):
        parts.append(f"-{key}")
    for key in sorted(before.keys() & after.keys()):
        if before[key] != after[key]:
            parts.append(f"{key}: {before[key]} -> {after[key]}")
    return ", ".join(parts)


def command_diff(context: dict[str, object], args: argparse.Namespace) -> int:
    """Diff two snapshot directories."""
    baseline = load_snapshots(args.baseline)
    current = load_snapshots(args.current or context["snapshot"])
    if not baseline:
        print(f"cdist-render: no snapshots in {args.baseline}")
        return 2
    report: dict[str, object] = {
        "baseline": str(args.baseline),
        "current": str(args.current or context["snapshot"]),
        "new_hosts": sorted(current.keys() - baseline.keys()),
        "gone_hosts": sorted(baseline.keys() - current.keys()),
        "hosts": {},
    }
    changed = 0
    for host in sorted(baseline.keys() & current.keys()):
        changes = diff_host(baseline[host], current[host])
        if changes:
            changed += 1
            report["hosts"][host] = changes
    if args.json:
        print(json.dumps(report, indent=1, sort_keys=True))
    else:
        if report["new_hosts"]:
            print(f"hosts only in the current snapshot: "
                  f"{', '.join(report['new_hosts'])}")
        if report["gone_hosts"]:
            print(f"hosts only in the baseline: "
                  f"{', '.join(report['gone_hosts'])}")
        for host, changes in report["hosts"].items():
            total = sum(len(items) for items in changes.values())
            print(f"{host}: {total} change(s)")
            if args.quiet:
                continue
            for kind in ("status", "added", "removed", "parameters", "require",
                         "autorequire", "order"):
                for line in changes.get(kind, []):
                    print(f"   {kind}: {line}")
        print(f"cdist-render: {changed} of "
              f"{len(baseline.keys() & current.keys())} hosts change, "
              f"{len(report['new_hosts'])} new, {len(report['gone_hosts'])} gone")
    return 1 if changed or report["new_hosts"] or report["gone_hosts"] else 0


def main() -> int:
    """Entry point."""
    args = build_parser().parse_args()
    context = resolve(args)
    if args.command == "render":
        return command_render(context, args)
    return command_diff(context, args)


if __name__ == "__main__":
    sys.exit(main())
